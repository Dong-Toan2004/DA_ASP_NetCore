@using Application.DataTransferObjects.Product
@model IEnumerable<ProductDto>

@{
    ViewData["Title"] = "Lọc";
}

<link rel="stylesheet" href="~/css/home_Index.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/SortProduct.css" asp-append-version="true" />
<div class="search-wrapper">
    <div class="py-3 search-container">
        <form asp-controller="Home" asp-action="Index" method="get" class="search-bar d-flex justify-content-center" role="search">
            <input name="Name" class="form-control me-2 w-50" type="search" placeholder="Search" aria-label="Search" value="" />
            <button class="btn btn-outline-dark" type="submit">Search</button>
        </form>
    </div>

    <div id="categoryButtons"
         class="category-buttons mt-3 d-flex justify-content-center gap-3 flex-wrap">
        <a class="btn btn-outline-dark">Mì</a>
        <a class="btn btn-outline-dark">Bún</a>
        <a class="btn btn-outline-dark">Cơm</a>
        <a class="btn btn-outline-dark">Đồ ăn nhanh</a>
        <a class="btn btn-outline-dark">Tráng miệng</a>
        <a class="btn btn-outline-dark">Đồ uống</a>
    </div>
</div>
<div class="container" style="margin-top: 25px; margin-bottom: 50px;">
    <div class="row">
        <div class="col-md-3 d-none d-md-block">
            <div class="product-sidebar">
                <h5 class="filter-title">Danh mục</h5>
                <ul class="list-unstyled">
                    <li><a href="#" class="nav-link text-dark">Tất cả</a></li>
                    <li><a href="#" class="nav-link text-dark">Mì & Bún</a></li>
                    <li><a href="#" class="nav-link text-dark">Cơm văn phòng</a></li>
                    <li><a href="#" class="nav-link text-dark">Đồ ăn nhanh</a></li>
                    <li><a href="#" class="nav-link text-dark">Đồ uống</a></li>
                </ul>

                <h5 class="filter-title mt-4">Khoảng giá</h5>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="price" id="p1">
                    <label class="form-check-label" for="p1">Dưới 50.000đ</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="price" id="p2">
                    <label class="form-check-label" for="p2">50.000đ - 150.000đ</label>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4>Thực đơn của chúng tôi (@Model.Count())</h4>
                <select class="form-select sort-select">
                    <option>Sắp xếp: Mới nhất</option>
                    <option>Giá: Thấp đến Cao</option>
                    <option>Giá: Cao đến Thấp</option>
                </select>
            </div>

            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var product in Model)
                {
                    <div class="col">
                        <div class="card h-100 position-relative">
                            <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@product.Id" style="text-decoration:none; color: black">
                                <div class="card-img-wrapper position-relative">
                                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/img/default.jpg" : product.ImageUrl)"
                                         class="card-img-top" alt="@product.Name" style="object-fit:cover; height:250px;">
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="card-text text-truncate">@product.Description</p>
                                </div>
                                <div class="card-footer">
                                    <span class="text-muted pricecss d-block">@product.Price.ToString("N0") ₫</span>
                                </div>
                            </a>
                            <button type="button" class="add-to-cart-btn" onclick="addToCart('@product.Id')">
                                <i class="bi bi-cart-plus-fill"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">Sau</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055;">
    <div id="cartToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="cartToastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script src="~/js/cart.js" asp-append-version="true"></script>